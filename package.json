{
  "name": "emptrakr-desktop",
  "private": true,
  "version": "1.2.30",
  "description": "EmpTrakr Desktop Application",
  "author": "EmpTrakr",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "electron:ensure": "node scripts/ensure-electron.cjs",
    "electron:repair": "node scripts/ensure-electron.cjs --force",
    "dev:react": "vite",
    "dev:electron": "node scripts/ensure-electron.cjs && wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "node scripts/ensure-electron.cjs && concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build": "tsc -b && vite build",
    "electron:build": "node scripts/ensure-electron.cjs && npm run build && node scripts/write-electron-config.cjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never",
    "electron:build:mac": "node scripts/ensure-electron.cjs && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --arm64",
    "electron:build:mac:signed": "node scripts/validate-signing.cjs && node scripts/ensure-electron.cjs && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=true electron-builder --mac --config.forceCodeSigning=true --config.mac.notarize=true",
    "electron:publish": "node scripts/validate-release.cjs && node scripts/validate-backend.cjs && node scripts/validate-signing.cjs && node scripts/ensure-electron.cjs && npm run build && electron-builder --win -p always --config.forceCodeSigning=true",
    "release:check": "node scripts/validate-release.cjs",
    "preview": "vite preview",
    "predev": "node scripts/write-electron-config.cjs --development",
    "predev:electron": "node scripts/write-electron-config.cjs --development",
    "prebuild": "node scripts/write-electron-config.cjs",
    "test": "node --test tests/*.test.js",
    "backend:check": "node scripts/validate-backend.cjs",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "active-win": "^7.7.2",
    "axios": "^1.20.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.yohrmx.timetracker",
    "productName": "EmpTrakr",
    "publish": [
      {
        "provider": "github",
        "owner": "YoForex005",
        "repo": "Emptrakr_releases_desktop"
      }
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
